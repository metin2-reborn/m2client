pyexec "import sys\nf=sys._getframe()\nms=None\nwhile f:\n  ms = f.f_locals.get('main_stream', ms)\n  f=f.f_back\nw=ms.cur_phase_window\nfrom metin2 import log\nlog.trace_error('LSTCHK rows %d children %d' % (len(w.channel_list.items), len(w.channel_list._children)))"
