# Login screen walkthrough: server board -> login board -> typed ID/password -> login attempt.
# Click targets are kept off the exact centre of buttons: the centre pixel belongs to the
# zero-size text child window (same as on Windows). The targets are for a 1280x720 window.
resize 1280 720
waitframes 5
wait 2500
screenshot login_00.png
audio
# pick channel 1, then "OK" on the server board (380x410, bottom margin 80: OK is at y 574-600)
click left 760 299
wait 300
click left 770 585
wait 1000
screenshot login_01.png
# ID field, then password field (edit lines at (610,324)/(610,351), 120x18)
click left 660 333
wait 200
text "testuser"
wait 300
click left 660 360
wait 200
text "secret"
wait 500
screenshot login_02.png
# Enter in the password field triggers the login button (the connect attempt fails without a server)
key DIK_RETURN
wait 2500
screenshot login_03.png
audio
quit
